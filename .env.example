# Copy this file to .env.local and fill in your values

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Google Gemini API
GOOGLE_GENAI_API_KEY=your-google-genai-api-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# App
NEXT_PUBLIC_BASE_URL=http://localhost:9000

# Duffel API (sandbox: duffel_test_... / production: duffel_live_...)
DUFFEL_ACCESS_TOKEN=duffel_test_...

# SerpAPI (serpapi.com) — Google Search + Google Maps + Google Flights + Google Hotels
SERPAPI_KEY=your-serpapi-key

# Viator (Tripadvisor) — activités : catalogue officiel, clé gratuite
# Niveau « Basic Access » : inscription en self-service, le client réserve et
# paie sur viator.com (commission affilié). Prioritaire sur SerpAPI.
# Bac à sable : api.sandbox.viator.com/partner
VIATOR_API_KEY=your-viator-api-key
VIATOR_BASE_URL=https://api.sandbox.viator.com/partner

# Bokun (Tripadvisor) — activités et excursions réservables
# Facultatif : sans ces clés, les activités sont cherchées via SerpAPI
# (GetYourGuide, Viator…) avec un lien vers le site du prestataire.
# Avec Bokun, le revendeur encaisse lui-même : les activités deviennent
# facturables via Stripe (basculer 'activity' dans PAYABLE_TYPES,
# src/lib/cart-rules.ts, une fois les contrats opérateurs signés).
# Clés à créer depuis le compte Bokun. Bac à sable : api.bokuntest.com
BOKUN_ACCESS_KEY=your-bokun-access-key
BOKUN_SECRET_KEY=your-bokun-secret-key
BOKUN_BASE_URL=https://api.bokuntest.com
